# Optional. Without a key the app runs in demo mode with simulated agent output.
ANTHROPIC_API_KEY=
# Optional model override
SCALVS_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=

# OpenClaw (open source, MIT): when OPENCLAW_URL is set, every agent step runs on
# an OpenClaw gateway and outranks all other engines. See docs/openclaw.md.
# OPENCLAW_URL=http://127.0.0.1:18789/v1
# OPENCLAW_TOKEN=                      # secret: full operator access to the gateway
# OPENCLAW_AGENT=openclaw/default
# OPENCLAW_MODEL=ollama/qwen3:8b       # optional, sent as x-openclaw-model

# Keyless open-weight models (no API key, no spend): any OpenAI-compatible server
# you run — Ollama (default), llama.cpp, vLLM, LM Studio. Third tier behind
# ANTHROPIC_API_KEY and the Workers AI binding, so live mode works with zero keys.
# OPEN_WEIGHTS_URL=http://localhost:11434/v1
# OPEN_WEIGHTS_MODEL=qwen3:8b
# OPEN_WEIGHTS_THINK_MODEL=deepseek-r1:14b
# OPEN_WEIGHTS_KEY=
#
# Resilience (see api/_resilience.js, identical copy in Conjure src/resilience.js):
# OPEN_WEIGHTS_URL may list several servers, comma-separated — requests fail over
# between them. Retryable statuses retry with backoff (Retry-After is honoured);
# a dead server trips a circuit breaker and is skipped while it cools down.
# OPEN_WEIGHTS_RETRIES=2
# OPEN_WEIGHTS_RETRY_BASE_MS=400
# OPEN_WEIGHTS_REDACT=off              # default: credentials in prompts are stripped before they are sent

# Predictive forecasts: URL of the self-hosted CONJURE™ engine (an unmodified
# MiroFish backend, AGPL-3.0). Leave unset for demo mode. CONJURE_TOKEN is sent as
# a Bearer token if the engine sits behind an auth gateway (recommended: the
# engine has no auth of its own). MIROFISH_URL / MIROFISH_TOKEN still work.
CONJURE_URL=
CONJURE_TOKEN=
