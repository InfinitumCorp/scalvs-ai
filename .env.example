# Optional. Without a key the app runs in demo mode with simulated agent output.
ANTHROPIC_API_KEY=
# Optional model override
SCALVS_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=

# OpenClaw (open source, MIT): when OPENCLAW_URL is set, every agent step runs on
# an OpenClaw gateway and outranks all other engines. See docs/openclaw.md.
# OPENCLAW_URL=http://127.0.0.1:18789/v1
# OPENCLAW_TOKEN=                      # secret: full operator access to the gateway
# OPENCLAW_AGENT=openclaw/default
# OPENCLAW_MODEL=ollama/qwen3:8b       # optional, sent as x-openclaw-model

# Keyless open-weight models (no API key, no spend): any OpenAI-compatible server
# you run — Ollama (default), llama.cpp, vLLM, LM Studio. Third tier behind
# ANTHROPIC_API_KEY and the Workers AI binding, so live mode works with zero keys.
# OPEN_WEIGHTS_URL=http://localhost:11434/v1
# OPEN_WEIGHTS_MODEL=qwen3:8b
# OPEN_WEIGHTS_THINK_MODEL=deepseek-r1:14b
# OPEN_WEIGHTS_KEY=
#
# Resilience (see api/_resilience.js, identical copy in Conjure src/resilience.js):
# OPEN_WEIGHTS_URL may list several servers, comma-separated — requests fail over
# between them. Retryable statuses retry with backoff (Retry-After is honoured);
# a dead server trips a circuit breaker and is skipped while it cools down.
# OPEN_WEIGHTS_TIMEOUT_MS=120000     # per model call; raise for CPU-only servers (OpenClaw adds ~13.5k prompt tokens)
# OPEN_WEIGHTS_RETRIES=2
# OPEN_WEIGHTS_RETRY_BASE_MS=400
# OPEN_WEIGHTS_REDACT=off              # default: credentials in prompts are stripped before they are sent

# Langfuse (LLM tracing): one span per Workers AI call. On whenever both keys are set. Secrets.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=                 # secret
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU (default); US: https://us.cloud.langfuse.com
# LANGFUSE=off
# LANGFUSE_CAPTURE_CONTENT=on          # default off: no prompts or replies leave the Worker
# Mixpanel (Startup Plan): build-time, public project token. Off until set. Page views + sessions only.
# MIXPANEL_PROJECT_TOKEN=
# MIXPANEL_REGION=US                   # US | EU | IN, must match the project's data residency
# MIXPANEL=off

# Search (#/search) and DeepSearch web provider. Optional: the first one set wins;
# with none, the keyless Wikipedia + Hacker News APIs are used.
# EXA_API_KEY=                         # secret, Exa web search (startup credits); after VEIL, and VEIL's fallback
# EXA_SEARCH=off
# BRAVE_SEARCH_API_KEY=                # secret, Brave Search API (free tier)
# GOOGLE_CSE_KEY=                      # secret, Google Programmable Search (100 free/day)
# GOOGLE_CSE_CX=
# VEIL_SEARCH_URL=https://infinitumveil.app/api/search   # Infinitum's own engine, no key; used first
# SEARXNG_URL=https://searx.example    # your own SearXNG with format=json enabled

# Predictive forecasts: URL of the self-hosted CONJURE™ engine (an unmodified
# MiroFish backend, AGPL-3.0). Leave unset for demo mode. CONJURE_TOKEN is sent as
# a Bearer token if the engine sits behind an auth gateway (recommended: the
# engine has no auth of its own). MIROFISH_URL / MIROFISH_TOKEN still work.
CONJURE_URL=
CONJURE_TOKEN=

# Plans and billing (src/billing.js): the Infinitum revenue Worker that runs Stripe
# Checkout, the customer portal and entitlements. Public URL, baked into dist/src/config.js
# by `npm run build`. The app sends it the user's Cumulus ID token, never a Stripe key.
# REVENUE_URL=https://infinitum-revenue.infinitumcorp.workers.dev
