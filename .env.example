# Optional. Without a key the app runs in demo mode with simulated agent output.
ANTHROPIC_API_KEY=
# Optional model override
SCALVS_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=

# Predictive forecasts: URL of the self-hosted CONJURE™ engine (an unmodified
# MiroFish backend, AGPL-3.0). Leave unset for demo mode. CONJURE_TOKEN is sent as
# a Bearer token if the engine sits behind an auth gateway (recommended: the
# engine has no auth of its own). MIROFISH_URL / MIROFISH_TOKEN still work.
CONJURE_URL=
CONJURE_TOKEN=

# Optional Google AI Studio (Gemini) fallback. Free tier, plain API key from
# https://aistudio.google.com/apikey — not Vertex AI and not a billed project.
# Used only after Claude and Workers AI, or when an earlier provider returns 429.
# Leave the key blank to keep Gemini off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional Google Workspace connectors (Gmail, Drive, Calendar). Off unless both
# are set. OAuth client type: Web application. Do not attach a billing account.
# Authorized redirect: https://<host>/api/google/callback
# Local: http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional 32-byte key (base64 or 64 hex chars). When unset, a key is derived
# from GOOGLE_CLIENT_SECRET. Tokens are encrypted with AES-GCM.
# GOOGLE_TOKEN_KEY=
# GOOGLE_REDIRECT_URI=
