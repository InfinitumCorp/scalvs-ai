# Optional. Without a key the app runs in demo mode with simulated agent output.
ANTHROPIC_API_KEY=
# Optional model override
SCALVS_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=

# Predictive forecasts: URL of a self-hosted, unmodified MiroFish backend (AGPL-3.0).
# Leave unset for demo mode. MIROFISH_TOKEN is sent as a Bearer token if your
# MiroFish sits behind an auth gateway (recommended: MiroFish has no auth of its own).
MIROFISH_URL=
MIROFISH_TOKEN=
