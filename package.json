{
  "name": "scalvs-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SCALVS.ai — Infinitum's AI workforce platform (prototype)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
