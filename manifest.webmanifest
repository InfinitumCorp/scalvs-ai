{
  "id": "/",
  "name": "SCALVS.ai",
  "short_name": "SCALVS",
  "description": "SCALVS.ai by Infinitum: AI agents that research, write, code, browse and automate for you.",
  "start_url": "/#/command",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/public/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/public/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/public/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/public/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New task", "url": "/#/command", "icons": [{ "src": "/public/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Automations", "url": "/#/automations", "icons": [{ "src": "/public/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Connect", "url": "/#/connect", "icons": [{ "src": "/public/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
