{
  "$schema": "node_modules/wrangler/config-schema.json",
  // SCALVS.ai on Cloudflare Workers: static app from dist/ (npm run build),
  // /api/run and /api/forecast from worker.js. Secrets (ANTHROPIC_API_KEY,
  // CONJURE_TOKEN, …) are set with `wrangler secret put`, never here.
  "name": "scalvs-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  // Global users run on US servers (Ashburn, Virginia); Russia is served by the ru.* copies on Yandex Cloud.
  "placement": { "region": "gcp:us-east4" },
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Production domains (zone scalvs.app is on this Cloudflare account).
  "routes": [
    { "pattern": "scalvs.app", "custom_domain": true },
    { "pattern": "www.scalvs.app", "custom_domain": true }
  ],
  // No public *.workers.dev route; each uploaded version (npm run deploy:preview)
  // gets its own preview URL for testing before it serves users.
  "workers_dev": false,
  "preview_urls": true,
  // Workers AI runs SCALVS agents and CONJURE forecasts when no ANTHROPIC_API_KEY
  // or CONJURE_URL is set. WORKERS_AI_MODEL overrides the model.
  "ai": { "binding": "AI" },
  // The account-wide free Workers AI ledger, owned by the conjure-llm Worker.
  "durable_objects": { "bindings": [{ "name": "AI_BUDGET", "class_name": "Budget", "script_name": "conjure-llm" }] },
  "vars": {
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // SCALVS Search asks VEIL Search (Infinitum's own engine, no key) first.
    "VEIL_SEARCH_URL": "https://infinitumveil.app/api/search"
  },
  // Per-IP cap on API POSTs (worker.js).
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1701", "simple": { "limit": 60, "period": 60 } }
  ],
  // Connectors (api/connectors.js): encrypted tokens per visitor session. Wrangler
  // provisions the namespace on first deploy. Secrets: CONNECT_SECRET (required),
  // and per OAuth app GOOGLE_, MICROSOFT_, SLACK_, GITHUB_ + CLIENT_ID / CLIENT_SECRET.
  // Each app's redirect URI is https://scalvs.app/api/oauth/callback.
  "kv_namespaces": [{ "binding": "CONNECT", "id": "20685a2fcc18403db18e5bed4e5e96bd" }],
  // DeepSearch (api/grok.js): optional secret BRAVE_SEARCH_API_KEY for better web results.
  // Browser control (api/_browser.js): headless Chrome via Browser Rendering.
  "browser": { "binding": "BROWSER", "remote": true },
  // Automations (api/automations.js): run due scheduled tasks every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
