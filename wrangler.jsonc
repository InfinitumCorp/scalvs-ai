{
  "$schema": "node_modules/wrangler/config-schema.json",
  // SCALVS.ai on Cloudflare Workers: static app from dist/ (npm run build),
  // /api/run and /api/forecast from worker.js. Secrets (ANTHROPIC_API_KEY,
  // CONJURE_TOKEN, …) are set with `wrangler secret put`, never here.
  "name": "scalvs-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Production domains (zone scalvs.app is on this Cloudflare account).
  "routes": [
    { "pattern": "scalvs.app", "custom_domain": true },
    { "pattern": "www.scalvs.app", "custom_domain": true }
  ],
  // Workers AI runs SCALVS agents and CONJURE forecasts when no ANTHROPIC_API_KEY
  // or CONJURE_URL is set. WORKERS_AI_MODEL overrides the model.
  "ai": { "binding": "AI" },
  "vars": { "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast" },
  // Per-IP cap on API POSTs (worker.js).
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1701", "simple": { "limit": 60, "period": 60 } }
  ],
  // Connectors (api/connectors.js): encrypted tokens per visitor session. Wrangler
  // provisions the namespace on first deploy. Secrets: CONNECT_SECRET (required),
  // and per OAuth app GOOGLE_, MICROSOFT_, SLACK_, GITHUB_ + CLIENT_ID / CLIENT_SECRET.
  // Each app's redirect URI is https://scalvs.app/api/oauth/callback.
  "kv_namespaces": [{ "binding": "CONNECT" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
